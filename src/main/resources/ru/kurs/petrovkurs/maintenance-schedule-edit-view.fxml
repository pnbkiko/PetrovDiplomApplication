<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kurs.petrovkurs.controller.MaintenanceScheduleEditViewController"
            style="-fx-background-color: #f5f7fa; -fx-padding: 20;" stylesheets="styles_machines.css">

    <top>
        <VBox spacing="10" style="-fx-padding: 0 0 20 0;">
            <Label text="Форма графика технического обслуживания"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Заполните все поля для создания или редактирования графика ТО"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="15" vgap="15" style="-fx-padding: 20;">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="430"/>
            </columnConstraints>
            <rowConstraints>

                    <RowConstraints minHeight="40" prefHeight="40" />
                    <RowConstraints minHeight="40" prefHeight="40" />
                    <RowConstraints minHeight="40" prefHeight="40" />
                    <RowConstraints minHeight="40" prefHeight="40" />
                    <RowConstraints minHeight="30" prefHeight="30" />  <!-- Информация о периодичности -->
                    <RowConstraints />  <!-- Информационная панель -->
                    <RowConstraints minHeight="60" prefHeight="60" />  <!-- Поле для ошибок -->

            </rowConstraints>

            <!-- Строка 0: Станок -->
            <Label text="Станок *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="ComboBoxMachine" styleClass="modern-combo"
                      promptText="Выберите станок"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Строка 1: Вид ТО -->
            <Label text="Вид ТО *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="ComboBoxType" styleClass="modern-combo"
                      promptText="Выберите вид ТО"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Строка 2: Дата последнего ТО -->
            <Label text="Дата последнего ТО *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="DatePickerLastDone" styleClass="modern-datepicker"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Строка 3: Дата следующего ТО -->
            <Label text="Дата следующего ТО *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="DatePickerNextDue" styleClass="modern-datepicker"
                        GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Строка 4: Информационная панель -->
            <VBox spacing="5" style="-fx-background-color: #e8f4f8; -fx-background-radius: 5; -fx-padding: 15; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 1;"
                  GridPane.rowIndex="5" GridPane.columnSpan="2"
                  maxWidth="Infinity">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💡" style="-fx-font-size: 16px;"/>
                    <Label text="Информация" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                </HBox>
                <Label text="Поля, помеченные звездочкой (*), обязательны для заполнения. Дату следующего ТО можно рассчитать автоматически на основе периодичности вида ТО."
                       style="-fx-text-fill: #34495e; -fx-font-size: 13px;"
                       wrapText="true"
                       maxWidth="Infinity"/>
            </VBox>
            <!-- Строка 4: Информация о периодичности -->
            <Label fx:id="intervalInfoLabel" style="-fx-font-size: 12px;"
                   visible="false" wrapText="true"
                   GridPane.rowIndex="4" GridPane.columnSpan="2">
                <GridPane.margin>
                    <Insets top="5" bottom="5"/>
                </GridPane.margin>
            </Label>

            <!-- Строка 5: Поле для ошибок -->
            <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: normal;"
                   visible="false" wrapText="true"
                   GridPane.rowIndex="6" GridPane.columnSpan="2"
                   maxWidth="Infinity">
                <GridPane.margin>
                    <Insets top="10"/>
                </GridPane.margin>
            </Label>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="BtnCancel" text="Отмена" styleClass="btn-cancel"
                    onAction="#handleCancel"/>
            <Button fx:id="BtnSave" text="Сохранить" styleClass="btn-primary"
                    onAction="#handleSave" defaultButton="true"/>
        </HBox>
    </bottom>

</BorderPane>