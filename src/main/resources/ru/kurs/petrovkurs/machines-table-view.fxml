<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<BorderPane maxWidth="Infinity" maxHeight="Infinity" prefHeight="600.0" prefWidth="900.0"
            stylesheets="@main.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kurs.petrovkurs.controller.MachinesTableViewController">

    <style>
        <String fx:value="-fx-background-color: #ecf0f1;"/>
    </style>

    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10 15;" alignment="CENTER">
            <children>
                <MenuBar style="-fx-background-color: transparent;">
                    <menus>
                        <Menu mnemonicParsing="false" text="Правка"
                              style="-fx-text-fill: white; -fx-font-size: 14;">
                            <items>
                                <MenuItem fx:id="MenuItemAdd" mnemonicParsing="false"
                                          onAction="#MenuItemAddAction" text="Добавить"
                                          style="-fx-text-fill: #2c3e50;"/>
                                <MenuItem fx:id="MenuItemDelete" mnemonicParsing="false"
                                          onAction="#MenuItemDeleteAction" text="Удалить"
                                          style="-fx-text-fill: #2c3e50;"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Станки"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label fx:id="LabelDate" text="Дата"
                           style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <!-- Панель поиска -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                <Label text="🔍 Поиск:" style="-fx-font-size: 14; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                <TextField fx:id="TextFieldSearch"
                           promptText="Поиск по модели, производителю, инв. номеру, серийному номеру, типу..."
                           style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 3; -fx-pref-width: 400;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✖ Очистить" onAction="#clearSearch"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;"/>
            </HBox>

            <!-- Таблица станков -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Список станков:"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 16; -fx-font-weight: bold;"/>

                <TableView fx:id="TableViewMachines" styleClass="modern-table" onMouseClicked="#onTableDoubleClick">
                    <columns>
                        <TableColumn fx:id="TableColumnType" text="Тип станка" prefWidth="120">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnModel" text="Модель" prefWidth="150">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnModification" text="Модификация" prefWidth="100">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnManufacturer" text="Производитель" prefWidth="120">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnManufacturingYear" text="Год выпуска" prefWidth="80">
                            <style>
                                <String fx:value="-fx-alignment: CENTER; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnSerialNumber" text="Серийный номер" prefWidth="120">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnInvNumber" text="Инв. номер" prefWidth="100">
                            <style>
                                <String fx:value="-fx-alignment: CENTER; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnCommissionedAt" text="Дата ввода" prefWidth="100">
                            <style>
                                <String fx:value="-fx-alignment: CENTER; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10 15;" alignment="CENTER">
            <children>
                <Label fx:id="LabelInfo" text="Всего записей: 0"
                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="⚙️ Станки"
                       style="-fx-text-fill: #3498db; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>