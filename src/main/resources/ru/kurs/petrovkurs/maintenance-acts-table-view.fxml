<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<BorderPane maxWidth="Infinity" maxHeight="Infinity" prefHeight="600.0" prefWidth="800.0"
            stylesheets="@main.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kurs.petrovkurs.controller.MaintenanceActsTableViewController">

    <style>
        <String fx:value="-fx-background-color: #ecf0f1;"/>
    </style>

    <top>
        <!-- Верхняя панель с меню и информацией -->
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10 15;" alignment="CENTER">
            <children>
                <!-- Меню -->
                <MenuBar style="-fx-background-color: transparent;">
                    <menus>
                        <Menu mnemonicParsing="false" text="Правка"
                              style="-fx-text-fill: white; -fx-font-size: 14;">
                            <items>
                                <MenuItem fx:id="MenuItemAdd" mnemonicParsing="false"
                                          onAction="#MenuItemAddAction" text="Добавить"
                                          style="-fx-text-fill: #2c3e50;"/>
                                <MenuItem fx:id="MenuItemDelete" mnemonicParsing="false"
                                          onAction="#MenuItemDeleteAction" text="Удалить"
                                          style="-fx-text-fill: #2c3e50;"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Заголовок -->
                <Label text="Акты технического обслуживания"
                       style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Информация о дате -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label fx:id="LabelDate" text="Дата"
                           style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <!-- Основной контент -->
        <VBox spacing="10" style="-fx-padding: 20;">
            <!-- Панель поиска/фильтрации -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
                <Label text="🔍" style="-fx-font-size: 16;"/>
                <DatePicker fx:id="DatePickerFilter" promptText="Фильтр по дате"
                            style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 3; -fx-pref-width: 200;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Сбросить фильтр"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 3;"/>
            </HBox>

            <!-- Таблица -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Список актов ТО:"
                       style="-fx-text-fill: #2c3e50; -fx-font-size: 16; -fx-font-weight: bold;"/>

                <TableView fx:id="TableViewMaintenanceActs" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="TableColumnMachines" text="Станок" prefWidth="150">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnTypes" text="Вид ТО" prefWidth="120">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnDate" text="Дата" prefWidth="100">
                            <style>
                                <String fx:value="-fx-alignment: CENTER; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnEngineer" text="Инженер" prefWidth="120">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnNotes" text="Замечания" prefWidth="200">
                            <style>
                                <String fx:value="-fx-alignment: CENTER_LEFT; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                        <TableColumn fx:id="TableColumnSigned" text="Подпись" prefWidth="100">
                            <style>
                                <String fx:value="-fx-alignment: CENTER; -fx-font-size: 13;"/>
                            </style>
                        </TableColumn>
                    </columns>
                    <style>
                        <String fx:value="-fx-background-color: white;"/>
                        <String fx:value="-fx-border-color: #dee2e6;"/>
                        <String fx:value="-fx-border-radius: 5;"/>
                        <String fx:value="-fx-background-radius: 5;"/>
                    </style>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <!-- Нижняя панель с информацией -->
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10 15;" alignment="CENTER">
            <children>
                <Label fx:id="LabelInfo" text="Информация о записях"
                       style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="📊 Акты ТО"
                       style="-fx-text-fill: #3498db; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>