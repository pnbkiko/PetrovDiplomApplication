<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kurs.petrovkurs.controller.MaintenanceTypesEditViewController"
            style="-fx-background-color: #f5f7fa; -fx-padding: 20;" stylesheets="@main.css">

    <top>
        <VBox spacing="10" style="-fx-padding: 0 0 20 0;">
            <Label text="Форма вида технического обслуживания"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Заполните поля для создания или редактирования вида ТО"
                   style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="15" vgap="15" style="-fx-padding: 20;">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="430"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="40" prefHeight="40" />
                <RowConstraints minHeight="40" prefHeight="40" />
                <RowConstraints />
                <RowConstraints minHeight="60" prefHeight="60" />
            </rowConstraints>

            <!-- Строка 0: Название вида ТО -->
            <Label text="Название *" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="TextFieldName" styleClass="modern-textfield"
                       promptText="Введите название вида ТО"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Строка 1: Интервал в днях -->
            <Label text="Интервал (дней) *" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <TextField fx:id="TextFieldIntervalDays" styleClass="modern-textfield"
                           promptText="Введите количество дней"
                           prefWidth="120"/>
                <ComboBox fx:id="ComboBoxIntervalPreset" promptText="Выберите шаблон"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 3;"/>
            </HBox>

            <!-- Строка 2: Информационная панель -->
            <VBox spacing="5" style="-fx-background-color: #e8f4f8; -fx-background-radius: 5; -fx-padding: 15; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 1;"
                  GridPane.rowIndex="2" GridPane.columnSpan="2"
                  maxWidth="Infinity">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💡" style="-fx-font-size: 16;"/>
                    <Label text="Информация о интервалах" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                </HBox>
                <Label text="Интервал определяет периодичность проведения ТО. Рекомендуемые значения: 30 дней (ежемесячно), 90 дней (ежеквартально), 180 дней (раз в полгода), 365 дней (ежегодно)."
                       style="-fx-text-fill: #34495e; -fx-font-size: 13;"
                       wrapText="true"
                       maxWidth="Infinity"/>
            </VBox>

            <!-- Строка 3: Поле для ошибок -->
            <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12; -fx-font-weight: normal;"
                   visible="false" wrapText="true"
                   GridPane.rowIndex="3" GridPane.columnSpan="2"
                   maxWidth="Infinity">
                <GridPane.margin>
                    <Insets top="10"/>
                </GridPane.margin>
            </Label>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="BtnCancel" text="Отмена" styleClass="btn-cancel"
                    onAction="#handleCancel"/>
            <Button fx:id="BtnSave" text="Сохранить" styleClass="btn-primary"
                    onAction="#handleSave" defaultButton="true"/>
        </HBox>
    </bottom>

</BorderPane>