<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kurs.petrovkurs.controller.MaintenanceActsEditViewController"
            style="-fx-background-color: #f5f7fa; -fx-padding: 20;">

    <top>
        <VBox spacing="10" style="-fx-padding: 0 0 20 0;">
            <Label text="Форма акта технического обслуживания"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Заполните все поля для создания или редактирования акта ТО"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="15" vgap="15" style="-fx-padding: 20;">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="500"/>
            </columnConstraints>

            <!-- Строка 1: Станок -->
            <Label text="Станок *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="ComboBoxMachine" styleClass="modern-combo" promptText="Выберите станок"
                      GridPane.rowIndex="0" GridPane.columnIndex="1">
                <placeholder>
                    <Label text="Выберите станок" style="-fx-text-fill: #95a5a6;"/>
                </placeholder>
            </ComboBox>

            <!-- Строка 2: Вид ТО -->
            <Label text="Вид ТО *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="ComboBoxType" styleClass="modern-combo" promptText="Выберите вид ТО"
                      GridPane.rowIndex="1" GridPane.columnIndex="1">
                <placeholder>
                    <Label text="Выберите вид ТО" style="-fx-text-fill: #95a5a6;"/>
                </placeholder>
            </ComboBox>

            <!-- Строка 3: Дата работы -->
            <Label text="Дата работы *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="DatePickerDateWork" styleClass="modern-datepicker"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Строка 4: Инженер -->
            <Label text="Инженер *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="TextFieldEngineer" styleClass="modern-textfield"
                       promptText="Введите ФИО инженера"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Строка 5: Замечания -->
            <Label text="Замечания" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="TextFieldNotes" styleClass="modern-textarea"
                      promptText="Введите замечания по проведенному ТО"
                      wrapText="true"
                      GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <!-- Строка 6: Подпись -->
            <Label text="Подтверждение *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="5" GridPane.columnIndex="1">
                <CheckBox fx:id="CheckBoxSigned" text="Подтверждаю выполнение ТО"
                          styleClass="modern-checkbox"/>
                <Label text="(требуется для сохранения)" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Информационная панель -->
            <VBox spacing="5" style="-fx-background-color: #e8f4f8; -fx-background-radius: 5; -fx-padding: 15; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 1;"
                  GridPane.rowIndex="6" GridPane.columnSpan="2">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💡" style="-fx-font-size: 16px;"/>
                    <Label text="Информация" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                </HBox>
                <Label text="Поля, помеченные звездочкой (*), обязательны для заполнения. После сохранения акт будет добавлен в общий список ТО."
                       style="-fx-text-fill: #34495e; -fx-font-size: 13px;" wrapText="true"/>
            </VBox>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="BtnCancel" text="Отмена" styleClass="btn-cancel"
                    onAction="#BtnCancelAction"/>
            <Button fx:id="BtnSave" text="Сохранить" styleClass="btn-primary"
                    onAction="#BtnSaveAction" defaultButton="true"/>
        </HBox>
    </bottom>

</BorderPane>