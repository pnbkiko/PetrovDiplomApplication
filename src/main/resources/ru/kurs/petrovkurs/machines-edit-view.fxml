<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kurs.petrovkurs.controller.MachinesEditViewController"
            style="-fx-background-color: #f5f7fa; -fx-padding: 20;" stylesheets="@main.css">

    <top>
        <VBox spacing="10" style="-fx-padding: 0 0 20 0;">
            <Label text="Форма станка"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Заполните все поля для создания или редактирования станка"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <GridPane hgap="15" vgap="15" style="-fx-padding: 20;">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="170"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="250" prefWidth="450"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints minHeight="40" prefHeight="40"/>
                    <RowConstraints/>
                    <RowConstraints minHeight="60" prefHeight="60"/>
                </rowConstraints>

                <!-- Строка 0: Тип станка -->
                <Label text="Тип станка *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="ComboBoxType" styleClass="modern-combo" promptText="Выберите тип станка"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Строка 1: Модель -->
                <Label text="Модель *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="TextFieldModel" styleClass="modern-textfield"
                           promptText="Введите модель станка"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Строка 2: Модификация -->
                <Label text="Модификация" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="TextFieldModification" styleClass="modern-textfield"
                           promptText="Введите модификацию (опционально)"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Строка 3: Производитель -->
                <Label text="Производитель *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="TextFieldManufacturer" styleClass="modern-textfield"
                           promptText="Введите производителя"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Строка 4: Год выпуска -->
                <Label text="Год выпуска" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="TextFieldManufacturingYear" styleClass="modern-textfield"
                           promptText="Введите год выпуска (например, 2020)"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Строка 5: Серийный номер -->
                <Label text="Серийный номер" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="TextFieldSerialNumber" styleClass="modern-textfield"
                           promptText="Введите серийный номер"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Строка 6: Инвентарный номер -->
                <Label text="Инвентарный номер *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="TextFieldInvNumber" styleClass="modern-textfield"
                           promptText="Введите инвентарный номер"
                           GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <!-- Строка 7: Дата ввода -->
                <Label text="Дата ввода *" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <DatePicker fx:id="DatePickerCommissionedAt" styleClass="modern-datepicker"
                            GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <!-- Строка 8: Информационная панель -->
                <VBox spacing="5" style="-fx-background-color: #e8f4f8; -fx-background-radius: 5; -fx-padding: 15; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 1;"
                      GridPane.rowIndex="8" GridPane.columnSpan="2" maxWidth="Infinity">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="💡" style="-fx-font-size: 16px;"/>
                        <Label text="Информация" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                    </HBox>
                    <Label text="Поля, помеченные звездочкой (*), обязательны для заполнения. После сохранения станок будет добавлен в общий список оборудования."
                           style="-fx-text-fill: #34495e; -fx-font-size: 13px;" wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <!-- Строка 9: Поле для ошибок -->
                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-font-weight: normal;"
                       visible="false" wrapText="true" GridPane.rowIndex="9" GridPane.columnSpan="2" maxWidth="Infinity">
                    <GridPane.margin>
                        <Insets top="10"/>
                    </GridPane.margin>
                </Label>
            </GridPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="BtnCancel" text="Отмена" styleClass="btn-cancel"
                    onAction="#BtnCancelAction"/>
            <Button fx:id="BtnSave" text="Сохранить" styleClass="btn-primary"
                    onAction="#BtnSaveAction" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>